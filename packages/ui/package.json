{
  "name": "@dlvlabs/ui",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "prepare": "mkdir -p dist && npm run build:css"
  },
  "devDependencies": {
    "@dlvlabs/eslint-config": "*",
    "@dlvlabs/tailwind-config": "*",
    "@dlvlabs/typescript-config": "*",
    "@turbo/gen": "^2.5.0",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "autoprefixer": "^10.4.14",
    "clsx": "^2.1.1",
    "eslint": "^9.25.0",
    "postcss": "^8.4.27",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^3.3.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
